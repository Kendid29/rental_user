# ==============================================================================
# RentalinAja Environment Configuration
# ==============================================================================

# NEXT_PUBLIC_USE_MOCK
# Menentukan apakah aplikasi menggunakan mock data (in-memory & localStorage)
# atau memanggil API backend nyata.
# Nilai: "true" (default untuk tahap mock-first) atau "false"
NEXT_PUBLIC_USE_MOCK=true

# NEXT_PUBLIC_API_BASE_URL
# Alamat dasar URL API backend produksi/staging.
# Wajib diisi jika NEXT_PUBLIC_USE_MOCK=false.
# Contoh: https://api.RentalinAja.id/v1
NEXT_PUBLIC_API_BASE_URL=

# NEXT_PUBLIC_NOMOR_WA_ADMIN
# Nomor WhatsApp resmi admin RentalinAja untuk konfirmasi pesanan (format 62...)
# Contoh: 6281234567890
NEXT_PUBLIC_NOMOR_WA_ADMIN=6281234567890
